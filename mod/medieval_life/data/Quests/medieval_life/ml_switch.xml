<?xml version="1.0" encoding="utf-8"?>
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="brambora">
	<!-- Switching between Henry, player 0, and the new character, player 2, for ml_switch and ml_uninstall (switch.lua).
	     To Henry, as the game does after it lets the player be someone else: Lua puts a token in the inventory of the new
	     character, which a trigger on that inventory hears, and when the switch ends Henry gets a
	     token. To the new character: a token in Henry's inventory. It is not to_new_life of ml_new_life, whose end starts
	     the life (the map, the weapons of the origin). It hangs from the project to reach every map. -->
	<Skald>
		<Gameplay Name="ml_switch">
			<Nodes>
				<ObjectProperties Name="henry" PositionY="0" PositionX="-900" DeclaringType="wh::rpgmodule::I_Soul">
					<Asset Name="I_Soul" Alias="player" />
				</ObjectProperties>
				<ObjectProperties Name="new_life" PositionY="200" PositionX="-900" DeclaringType="wh::rpgmodule::I_Soul">
					<Asset Name="I_Soul" Alias="new_life" />
				</ObjectProperties>
				<State Name="always_on" PositionY="-150" PositionX="-900" TypeT="bool">
					<Constant Name="DefaultValue" Value="true" />
				</State>
				<Function Name="back_descriptor" PositionY="200" PositionX="-600" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="421028ce-b581-5ab3-9871-961d9b23cff0" />
					<Constant Name="Amount" Value="1" />
				</Function>
				<ItemDescriptorTrigger Name="back_token" PositionY="200" PositionX="-300">
					<Edge From="new_life.Inventory" To="Inventory" />
					<Edge From="back_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<SwitchPlayer Name="to_henry" PositionY="200" PositionX="0">
					<Constant Name="PlayerId" Value="0" />
					<Edge From="back_token.OnAcquire" To="Exec" />
				</SwitchPlayer>
				<EventMemberFunction Name="back_done" PositionY="200" PositionX="300" MethodName="CreateItems" DeclaringType="wh::entitymodule::Inventory">
					<Constant Name="ItemClass" Value="2a80de10-48c6-5fc2-aeb2-a5d8fb72309a" />
					<Constant Name="Amount" Value="1" />
					<Constant Name="ShowUINotification" Value="false" />
					<Edge From="henry.Inventory" To="Inventory" />
					<Edge From="to_henry.OnFinished" To="Exec" />
				</EventMemberFunction>
				<Function Name="life_descriptor" PositionY="500" PositionX="-600" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="c5521005-5030-5d98-8910-c3055ba168fe" />
					<Constant Name="Amount" Value="1" />
				</Function>
				<ItemDescriptorTrigger Name="life_token" PositionY="500" PositionX="-300">
					<Edge From="henry.Inventory" To="Inventory" />
					<Edge From="life_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<SwitchPlayer Name="to_life" PositionY="500" PositionX="0">
					<Constant Name="PlayerId" Value="2" />
					<Edge From="life_token.OnAcquire" To="Exec" />
				</SwitchPlayer>
			</Nodes>
			<Assets>
				<SoulAsset Name="player" SharedSoulGuids="4c2dcffb-dea1-6263-72d7-b39f4db2d8b5" />
				<SoulAsset Name="new_life" SharedSoulGuids="e9f088ff-48e3-5fa1-b733-80504a56d1dc" />
			</Assets>
			<Text Text="ml_switch" />
		</Gameplay>
	</Skald>
</Database>
