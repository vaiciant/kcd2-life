		<action name="ml_key_i" onPress="1" keyboard="i" />
		<action name="ml_key_j" onPress="1" keyboard="j" />
		<action name="ml_key_k" onPress="1" keyboard="k" />
		<action name="ml_key_l" onPress="1" keyboard="l" />
		<action name="ml_key_m" onPress="1" keyboard="m" />
		<action name="ml_key_n" onPress="1" keyboard="n" />
