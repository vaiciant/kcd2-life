<?xml version="1.0"?>
<!-- Keys of the name screen (Scripts/MedievalLife/typing.lua). The map is only on while typing, over the dialog, with the
     priority of the barber screen. ml_key_enye is the key to the right of L, the one of the Spanish keyboard. -->
<actionmaps version="22">
	<actionmap name="ml_typing" priority="minigames_over" exclusivity="1">
		<include actionmap="open_pause_menu" />
		<action name="ml_key_a" onPress="1" keyboard="a" />
		<action name="ml_key_b" onPress="1" keyboard="b" />
		<action name="ml_key_c" onPress="1" keyboard="c" />
		<action name="ml_key_d" onPress="1" keyboard="d" />
